{
  "name": "timetracker-pro",
  "version": "1.0.0",
  "description": "Comprehensive browser extension for time tracking with detailed analytics",
  "main": "src/background/service-worker.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "package:chrome": "npm run build && cd dist && zip -r ../timetracker-chrome.zip .",
    "package:firefox": "npm run build && cd dist && zip -r ../timetracker-firefox.zip .",
    "package:all": "npm run package:chrome && npm run package:firefox"
  },
  "keywords": [
    "time-tracker",
    "productivity",
    "browser-extension",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "jest": "^29.7.0",
    "sharp": "^0.34.5",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "date-fns": "^2.30.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/assets/**"
    ]
  }
}
